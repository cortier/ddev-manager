{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "types": ["firefox-webext-browser", "vite/client"],
        "noEmit": true,
        "skipLibCheck": true
    },
    "include": ["extension/**/*.ts", "stories/**/*.ts", ".storybook/**/*.ts"]
}
